// Rendered by ~/.config/caelestia/hooks/theme-post.py; ~/.config/fastfetch/config.jsonc
// symlinks here. Edit the TEMPLATE in ~/.config/caelestia/theme-templates/.
// Colours follow the wallpaper: keys in the accent, rules in the outline grey.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "~/.config/fastfetch/fast-images/hypr.png",
        "type": "kitty-direct",
        // box sized to her true 2526x4096 ratio so she isn't stretched.
        "width": 40,
        "height": 30,
        "preserveAspectRatio": true,
        "padding": { "top": 2, "right": 4 }
    },

    "display": {
        "separator": "   ",
        "key": { "width": 15 },
        "color": {
            "keys": "38;2;{{ primary.red }};{{ primary.green }};{{ primary.blue }}",
            "title": "1;38;2;{{ primary.red }};{{ primary.green }};{{ primary.blue }}",
            "output": "38;2;{{ onSurface.red }};{{ onSurface.green }};{{ onSurface.blue }}",
            "separator": "38;2;{{ outline.red }};{{ outline.green }};{{ outline.blue }}"
        }
    },

    "modules": [
        "break",
        { "type": "custom", "format": "\u001b[1;38;2;{{ primary.red }};{{ primary.green }};{{ primary.blue }}mArchlinux\u001b[0;38;2;{{ outline.red }};{{ outline.green }};{{ outline.blue }}m  ·  {{ mode }}" },
        { "type": "custom", "format": "\u001b[38;2;{{ outline.red }};{{ outline.green }};{{ outline.blue }}m──────────────────────" },

        { "type": "os",       "key": " 󰣇  OS",       "format": "{2}" },
        { "type": "kernel",   "key": " 󰌽  Kernel" },
        { "type": "packages", "key": " 󰏖  Packages" },
        { "type": "shell",    "key": "   Shell" },
        { "type": "uptime",   "key": " 󰅐  Uptime" },
        "break",

        { "type": "wm",       "key": " 󰕮  WM" },
        { "type": "terminal", "key": " 󰆍  Terminal" },
        { "type": "terminalfont", "key": "   Font", "format": "{1}" },
        {
            "type": "command",
            "key": "   Wallpaper",
            "text": "basename \"$(cat ~/.local/state/caelestia/wallpaper/path.txt)\" | sed 's/\\.[^.]*$//'"
        },
        "break",

        { "type": "cpu",  "key": " 󰻠  CPU",  "format": "{1}" },
        { "type": "gpu",  "key": " 󰢮  GPU",  "format": "{2}" },
        { "type": "disk", "key": " 󰋊  Disk", "folders": "/" },
        {
            "type": "command",
            "key": " 󰍹  Display",
            "text": "hyprctl monitors -j | python3 -c 'import sys,json; print(\", \".join(f\"{m[\"width\"]}x{m[\"height\"]}@{round(m[\"refreshRate\"])}Hz\" for m in json.load(sys.stdin)))'"
        },
        "break",

        { "type": "colors", "paddingLeft": 2, "symbol": "circle" },
        "break"
    ]
}
