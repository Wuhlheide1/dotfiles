#!/usr/bin/env bash
# caelestia-update: careful updates for your self-built caelestia-shell-git and
# caelestia-cli-git (not `caelestia update` with a space: that is upstream's
# dots installer, which refuses to run here).
#
#   caelestia-update            what's new upstream -> build -> test -> install
#   caelestia-update --check    only show what's new upstream
#   caelestia-update --rebuild  rebuild the commits you have installed (after a
#                               Qt minor bump; the pacman hook tells you when)
#
# Every upstream commit since your build is listed; read the flagged ones first:
#   BREAKING  "type!:" or BREAKING in the message
#   OVERLAY   CLI commit touching the scheme code your `dynamic oled` overlay patches
#   CONFIG    shell commit touching config (new or renamed shell.json keys)
# Builds go to ~/.cache/caelestia-git-pkgs (the last 2 per package stay, so going
# back is `sudo pacman -U` on the older file). Before installing, it checks that
# the overlay still loads the new CLI and still offers `oled`, and that the shell's
# plugins were built against the installed Qt. Any failure = nothing installed.
set -euo pipefail

out=$HOME/.cache/caelestia-git-pkgs
work=$out/build
mode=update
case "${1:-}" in
    --check) mode=check ;;
    --rebuild) mode=rebuild ;;
    "") ;;
    *) sed -n '6,9p' "$0"; exit 2 ;;
esac

pkgs=(caelestia-shell-git caelestia-cli-git)
declare -A repo=([caelestia-shell-git]=shell [caelestia-cli-git]=cli)
say() { printf '\n\033[1;36m%s\033[0m\n' "$*"; }
die() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }
yes_no() { local a; read -r -p "$1 [Y/n] " a; [[ -z "$a" || "$a" =~ ^[Yy] ]]; }
installed_hash() { pacman -Q "$1" 2>/dev/null | grep -oP '\.g\K[0-9a-f]+(?=-)'; }

# Prints the new commits of one package; exit status 1 when there are none.
show_new() {
    local pkg=$1 h
    h=$(installed_hash "$pkg") || die "$pkg is not installed"
    python3 - "$pkg" "${repo[$pkg]}" "$h" <<'PY'
import json, re, subprocess, sys
pkg, name, base = sys.argv[1:]
api = lambda path: json.loads(subprocess.run(["gh", "api", path], check=True, capture_output=True, text=True).stdout)
cmp = api(f"repos/caelestia-dots/{name}/compare/{base}...main")
commits = cmp["commits"]
if not commits:
    print(f"{name}: up to date ({base})")
    sys.exit(1)
print(f"{name}: {len(commits)} new commit(s) since {base}")
for c in commits:
    msg = c["commit"]["message"]
    first = msg.splitlines()[0]
    files = [f["filename"] for f in api(f"repos/caelestia-dots/{name}/commits/{c['sha']}").get("files", [])]
    flags = []
    if re.match(r"^\w+(\([^)]*\))?!:", first) or "BREAKING" in msg:
        flags.append("BREAKING")
    if name == "cli" and any(f.startswith(("src/caelestia/utils/scheme", "src/caelestia/utils/material",
                                           "src/caelestia/utils/paths", "src/caelestia/__init__")) for f in files):
        flags.append("OVERLAY")
    if name == "shell" and any("config" in f.lower() for f in files):
        flags.append("CONFIG")
    tag = f"\033[1;33m[{' '.join(flags)}]\033[0m " if flags else ""
    print(f"  {c['sha'][:7]} {tag}{first}")
PY
}

build() {  # $1 = package, $2 = commit to pin ("" = upstream main)
    local pkg=$1 commit=${2:-}
    mkdir -p "$work"
    rm -rf "${work:?}/$pkg"
    git clone -q --depth 1 "https://aur.archlinux.org/$pkg.git" "$work/$pkg"
    if [ -n "$commit" ]; then
        sed -i 's|^source=("$pkgname::git+$url.git")|source=("$pkgname::git+$url.git#commit='"$commit"'")|' "$work/$pkg/PKGBUILD"
        grep -q "#commit=$commit" "$work/$pkg/PKGBUILD" || die "$pkg: the PKGBUILD's source line changed, can't pin the commit"
    fi
    # On disk, not in /tmp (a 7.8 GB tmpfs). makepkg keeps the upstream clone in src/.
    local env=(CMAKE_BUILD_PARALLEL_LEVEL=6 BUILDDIR="$work/makepkg" PKGDEST="$out" SRCDEST="$work/src")
    say "Building $pkg${commit:+ at $commit} (about a minute)"
    if [ "$pkg" = caelestia-cli-git ]; then
        # Its makedepends (python-build/-installer/-hatch/-hatch-vcs) aren't installed;
        # a pip --target folder gives makepkg the same modules, no sudo, no leftovers.
        [ -d "$work/pydeps/hatchling" ] ||
            python3 -m pip install -q --target "$work/pydeps" build installer hatchling hatch-vcs
        (cd "$work/$pkg" && env PYTHONPATH="$work/pydeps" "${env[@]}" nice makepkg -f -d --noconfirm >"$work/$pkg.log" 2>&1) ||
            die "build failed, log: $work/$pkg.log"
    else
        (cd "$work/$pkg" && env "${env[@]}" nice makepkg -f --noconfirm >"$work/$pkg.log" 2>&1) ||
            die "build failed, log: $work/$pkg.log"
    fi
    built_file=$(ls -t "$out/$pkg"-[0-9]*.pkg.tar.zst | head -1)
}

test_cli() {  # $1 = built package file
    local t real
    t=$(mktemp -d)
    bsdtar -xf "$1" -C "$t" usr/lib
    real=$(echo "$t"/usr/lib/python3*/site-packages)
    [ -d "$real/caelestia" ] || { rm -rf "$t"; die "no caelestia module inside $1"; }
    # A throwaway copy of your overlay that loads the NEW package instead of the installed one.
    mkdir -p "$t/ov/caelestia"
    sed "s|^real = Path(getsitepackages()\[0\]) / __name__|real = Path('$real') / __name__|" \
        "$HOME/.config/caelestia/cli-overlay/__init__.py" >"$t/ov/caelestia/__init__.py"
    grep -q "^real = Path('$real')" "$t/ov/caelestia/__init__.py" ||
        { rm -rf "$t"; die "the overlay's loader line changed; update test_cli in $0"; }
    python3 -s - "$t/ov" "$real" <<'PY' || { rm -rf "$t"; die "the oled overlay does not work with this CLI build: not installed"; }
import sys
ov, real = sys.argv[1:]
sys.path.insert(0, ov)
import caelestia
from caelestia.utils import scheme
import caelestia.subcommands.scheme
assert scheme.__file__.startswith(real), f"loaded the wrong CLI: {scheme.__file__}"
flavours = scheme.get_scheme_flavours("dynamic")
assert "oled" in flavours, f"no oled flavour, only {flavours}"
print(f"   overlay OK with the new CLI (dynamic: {', '.join(flavours)})")
PY
    rm -rf "$t"
}

test_shell() {  # $1 = built package file
    local t qt so built bad=0
    t=$(mktemp -d)
    bsdtar -xf "$1" -C "$t" usr/lib/qt6
    qt=$(pacman -Q qt6-base | grep -oP ' 6\.\K[0-9]+')
    while IFS= read -r so; do
        built=$(objdump -T "$so" 2>/dev/null | grep -oP 'Qt_6\.\K[0-9]+' | sort -n | tail -1)
        if [ -n "$built" ] && [ "$built" -lt "$qt" ]; then
            echo "   $(basename "$so") was built for Qt 6.$built, installed is 6.$qt"; bad=1
        fi
    done < <(find "$t" -name '*.so')
    rm -rf "$t"
    [ "$bad" = 0 ] || die "shell build doesn't match the installed Qt: not installed"
    echo "   shell plugins match Qt 6.$qt"
}

# --- which packages to build -------------------------------------------------
todo=()
declare -A pin=()
if [ "$mode" = rebuild ]; then
    for p in "${pkgs[@]}"; do todo+=("$p"); pin[$p]=$(installed_hash "$p"); done
else
    say "Upstream since your builds"
    for p in "${pkgs[@]}"; do show_new "$p" && todo+=("$p"); done
    [ "$mode" = check ] && exit 0
    [ ${#todo[@]} -gt 0 ] || { echo; echo "Nothing to build."; exit 0; }
    echo
    yes_no "Build and test ${todo[*]}?" || exit 0
fi

built=()
for p in "${todo[@]}"; do
    built_file=
    build "$p" "${pin[$p]:-}"
    f=$built_file
    [ -f "$f" ] || die "$p: no package file came out"
    say "Testing $(basename "$f")"
    if [ "$p" = caelestia-cli-git ]; then test_cli "$f"; else test_shell "$f"; fi
    built+=("$f")
done

# Keep the last 2 builds of each package.
for p in "${pkgs[@]}"; do
    ls -t "$out/$p"-[0-9]*.pkg.tar.zst 2>/dev/null | tail -n +3 | xargs -r rm -f --
done

say "Install"
printf '   %s\n' "${built[@]##*/}"
if [ ! -t 0 ]; then
    echo "   (no terminal: run this yourself)"
    echo "   sudo pacman -U ${built[*]}"
    exit 0
fi
sudo pacman -U "${built[@]}"
if [[ " ${todo[*]} " == *" caelestia-shell-git "* ]] && yes_no "Restart the shell now (windows stay open)?"; then
    caelestia shell -k >/dev/null 2>&1 || true
    sleep 1
    setsid -f caelestia shell -d >/dev/null 2>&1
    echo "   shell restarted"
fi
