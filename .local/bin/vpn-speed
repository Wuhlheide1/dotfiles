#!/usr/bin/env bash
# Honest VPN speed check against Cloudflare (not a VPN-chosen test server).
#
#   vpn-speed              measure the connection as it is right now
#   vpn-speed <tunnel>     A/B: measure direct, bring <tunnel> up via vpnctl,
#                          measure again, then restore whatever was up before
#   vpn-speed -a           A/B every imported tunnel, ranked by download
#
# Reports latency, jitter, download, upload and which IP/location the internet
# sees, so a "fast" result can't come from the tunnel silently not being used.
set -uo pipefail

CF=https://speed.cloudflare.com
# IPv4 only: the tunnel carries only v4 (v6 is blackholed into it), so direct
# must be measured over v4 too. Also, Cloudflare 429s a v6 address that runs
# repeated tests, which read as 0 Mbit/s.
curl() { command curl -4 "$@"; }
VPNCTL=(sudo -n /usr/local/bin/vpnctl)

# Latency + jitter: 20 pings to Cloudflare's anycast resolver (the nearest
# Cloudflare edge, so it follows the path the tunnel exits from). HTTP timing
# was tried first and mostly measured server think-time, not the line.
latency() {
    ping -c 20 -i 0.2 -W 2 1.1.1.1 2>/dev/null |
        awk -F'[/ ]' '/^rtt/ {printf "%.0f %.1f\n", $8, $10; f=1} END {if(!f) print "- -"}'
}

# Throughput: 4 parallel streams for ~10 s, summed, in Mbit/s. One stream
# under-reports on fast lines, so this is closer to what a browser/Steam sees.
# Cloudflare refuses single downloads >=100 MB (403), so each stream pulls
# 25 MB chunks back to back until the 10 s window closes.
download() {
    local i end=$((SECONDS + 10))
    for i in 1 2 3 4; do
        while [ $SECONDS -lt $end ]; do
            curl -so /dev/null -w '%{size_download}\n' --max-time $((end - SECONDS + 1)) \
                 "$CF/__down?bytes=25000000"
        done &
    done | awk -v t=10 '{s+=$1} END {printf "%.0f\n", s*8/1e6/t}'
    wait
}

upload() {
    local i
    for i in 1 2 3 4; do
        head -c 100000000 /dev/zero | curl -so /dev/null -w '%{size_upload} %{time_total}\n' \
             --max-time 10 --data-binary @- "$CF/__up" &
    done | awk '$2>0 {s+=$1/$2} END {printf "%.0f\n", s*8/1e6}'
    wait
}

where() {
    curl -s --max-time 5 "$CF/cdn-cgi/trace" | awk -F= '
        /^ip=/{ip=$2} /^loc=/{loc=$2} /^colo=/{colo=$2}
        END {printf "%s (%s, via %s)\n", ip, loc, colo}'
}

measure() {   # label
    local lat jit dl ul
    read -r lat jit < <(latency)
    dl=$(download); ul=$(upload)
    printf '%-10s %6s ms %5s ms %7s Mbit/s %7s Mbit/s   %s\n' \
        "$1" "$lat" "$jit" "$dl" "$ul" "$(where)"
    printf '%s %s %s %s\n' "$lat" "$jit" "$dl" "$ul" > "${STATE:-/tmp/vpn-speed-$$}.$1"
}

header() {
    printf '%-10s %9s %8s %14s %14s   %s\n' "" latency jitter download upload "seen as"
}

# Warn when the tunnel MTU doesn't fit inside the uplink (PPPoE here: 1492).
# WireGuard adds 80 bytes; a too-big tunnel MTU fragments and quietly halves speed.
mtu_check() {
    local ifc="$1" up wg
    up=$(ip -o link show "$(ip route show default | awk '{print $5; exit}')" | grep -oP 'mtu \K[0-9]+')
    wg=$(ip -o link show "$ifc" 2>/dev/null | grep -oP 'mtu \K[0-9]+')
    [ -n "$wg" ] && [ $((wg + 80)) -gt "$up" ] &&
        echo "!! $ifc mtu $wg + 80 > uplink $up: add 'MTU = $((up - 80))' to its config"
}

ab() {   # tunnel
    local t="$1" before
    # status is "key value" lines; only restore a tunnel that was actually up
    before=$("${VPNCTL[@]}" status 2>/dev/null |
             awk '$1=="state"{up=($2=="up")} $1=="name"{n=$2} END{if(up) print n}')
    [ -n "$before" ] && "${VPNCTL[@]}" down >/dev/null
    STATE=$(mktemp -u)
    measure direct
    "${VPNCTL[@]}" up "$t" >/dev/null || { echo "$t: failed to come up"; return 1; }
    sleep 2
    measure "$t"
    mtu_check "$t"
    "${VPNCTL[@]}" down >/dev/null
    [ -n "$before" ] && "${VPNCTL[@]}" up "$before" >/dev/null
    read -r l0 _ d0 u0 < "$STATE.direct"; read -r l1 _ d1 u1 < "$STATE.$t"
    awk -v l0="$l0" -v l1="$l1" -v d0="$d0" -v d1="$d1" -v u0="$u0" -v u1="$u1" -v t="$t" '
        function pct(a,b) { return b>0 ? sprintf("%+.0f%%", (a/b-1)*100) : "n/a" }
        BEGIN { printf "=> %s: %+d ms latency, %s download, %s upload vs direct\n",
                t, l1-l0, pct(d1,d0), pct(u1,u0) }'
    rm -f "$STATE".*
}

case "${1:-}" in
    "")  header; STATE=$(mktemp -u); measure now; rm -f "$STATE".* ;;
    -a)  for t in $("${VPNCTL[@]}" list | awk '{print $1}'); do header; ab "$t"; echo; done ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)   header; ab "$1" ;;
esac
