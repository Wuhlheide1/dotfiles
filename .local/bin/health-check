#!/usr/bin/env bash
# Daily silent-failure watchdog. Checks the safety nets that fail quietly and
# sends ONE notification only if something is actually wrong. No output = healthy.
set -uo pipefail

problems=()

# 1. snapper: both configs should have a snapshot younger than 25h
for cfg in root home; do
    last="$(snapper -c "$cfg" list --columns date 2>/dev/null | tail -1)"
    if [ -z "$last" ] || ! ts="$(date -d "$last" +%s 2>/dev/null)"; then
        problems+=("snapper '$cfg': no snapshots at all")
    elif [ $(( $(date +%s) - ts )) -gt $(( 25 * 3600 )) ]; then
        problems+=("snapper '$cfg': newest snapshot older than 25h")
    fi
done

# 2. restic: newest backup should be younger than 26h (skip if drive unmounted)
if mountpoint -q /mnt/shared; then
    export RESTIC_REPOSITORY=/mnt/shared/backups/restic
    export RESTIC_PASSWORD_FILE="$HOME/.config/restic/password"
    newest="$(restic snapshots --json 2>/dev/null \
              | grep -o '"time":"[^"]*"' | tail -1 | cut -d'"' -f4)"
    if [ -z "$newest" ]; then
        problems+=("restic: could not read any snapshots")
    elif [ $(( $(date +%s) - $(date -d "$newest" +%s) )) -gt $(( 26 * 3600 )) ]; then
        problems+=("restic: newest backup older than 26h")
    fi
else
    problems+=("backup drive /mnt/shared is not mounted")
fi

# 3. failed systemd units (system + user)
sys_failed="$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}')"
usr_failed="$(systemctl --user --failed --no-legend --plain 2>/dev/null | awk '{print $1}')"
[ -n "$sys_failed" ] && problems+=("failed system units: $(tr '\n' ' ' <<<"$sys_failed")")
[ -n "$usr_failed" ] && problems+=("failed user units: $(tr '\n' ' ' <<<"$usr_failed")")

# 4. packages with a published security fix that isn't installed yet
if command -v arch-audit >/dev/null; then
    vuln="$(arch-audit -u -q 2>/dev/null | tr '\n' ' ')"
    [ -n "$vuln" ] && problems+=("security fixes waiting (paru -Syu): $vuln")
fi

# 5. Qt plugins on Qt's private API go silently wrong after a Qt minor bump
#    (2026-10-09: qtengine stuck on 6.11 -> every tray/notif icon missing).
qt_minor="$(pacman -Q qt6-base | grep -oP ' 6\.\K[0-9]+')"
declare -A stale=()
for f in /usr/lib/qt6/plugins/platformthemes/libqt6engine-plugin.so \
         /usr/lib/qt6/qml/Caelestia/lib/*.so; do
    [ -f "$f" ] || continue
    built="$(objdump -T "$f" 2>/dev/null | grep -oP 'Qt_6\.\K[0-9]+' | sort -n | tail -1)"
    [ -n "$built" ] && [ "$built" -lt "$qt_minor" ] && stale[$(pacman -Qqo "$f")]=1
done
[ ${#stale[@]} -gt 0 ] && problems+=("built for an older Qt, rebuild: paru -S --rebuild=yes ${!stale[*]}")

# 6. Caelestia theme engine (~/.config/caelestia/hooks/theme-post.py): a step
#    that crashed in the last day leaves some app on a stale palette.
theme_log="$HOME/.local/state/caelestia/theme-post.log"
if [ -f "$theme_log" ]; then
    since="$(date -d '-24 hours' '+%F %T')"
    failed="$(awk -v s="$since" '($1" "$2) >= s && $5 == "FAILED" {print $4}' "$theme_log" | sort -u | tr '\n' ' ')"
    [ -n "$failed" ] && problems+=("theme engine step failed: ${failed}(details in $theme_log)")
    # Spicetify refuses to refresh after a Spotify/Spicetify update; that is
    # logged as text, not as FAILED (it went unnoticed for 2 weeks in October).
    awk -v s="$since" '($1" "$2) >= s && /spotify: refresh failed/' "$theme_log" | grep -q . &&
        problems+=("Spotify theme stuck: spicetify -n restore backup apply")
fi

# --- Added 2026-11-10 (audit). Quiet on purpose: everything below reports a
# --- thing once, or at most once a week, and never as a critical popup.
notes=()
state="$HOME/.local/state/health-check"
mkdir -p "$state"

# 7. Caelestia's `dynamic oled` overlay is a link in Python's user site-packages.
#    A Python minor update (3.14 -> 3.15) moves that folder, the link is gone and
#    the flavour falls back to stock without an error. This one is a real breakage.
overlay="$(python3 -c 'import caelestia, os; print(os.path.realpath(caelestia.__file__))' 2>/dev/null)"
case "$overlay" in
    "$HOME/.config/caelestia/cli-overlay/"*) ;;
    *) problems+=("Caelestia overlay not loaded by $(python3 -V 2>&1): ln -s ~/.config/caelestia/cli-overlay $(python3 -c 'import site; print(site.getusersitepackages())')/caelestia") ;;
esac

# 8. New .pacnew/.pacsave files: each one is mentioned once (merge: sudo pacdiff).
if command -v pacdiff >/dev/null; then
    pacdiff -o 2>/dev/null | sort > "$state/pacnew.now"
    new="$(comm -23 "$state/pacnew.now" "$state/pacnew.seen" 2>/dev/null || cat "$state/pacnew.now")"
    mv "$state/pacnew.now" "$state/pacnew.seen"
    [ -n "$new" ] && notes+=("new config versions to merge (sudo pacdiff): $(tr '\n' ' ' <<<"$new")")
fi

# 9. Dotfiles: changes waiting and no commit for 14 days -> a reminder, max once a week.
dot=(git --git-dir="$HOME/.dotfiles" --work-tree="$HOME")
if last="$("${dot[@]}" log -1 --format=%ct 2>/dev/null)"; then
    dirty="$("${dot[@]}" status --porcelain --untracked-files=no 2>/dev/null | wc -l)"
    age=$(( ($(date +%s) - last) / 86400 ))
    if [ "$dirty" -gt 0 ] && [ "$age" -ge 14 ] && [ -z "$(find "$state/dotfiles.reminded" -mtime -7 2>/dev/null)" ]; then
        notes+=("dotfiles: $dirty changed files, last commit $age days ago (dotfiles add -u; dotfiles commit; dotfiles push)")
        touch "$state/dotfiles.reminded"
    fi
fi

[ ${#notes[@]} -gt 0 ] && { printf '%s\n' "${notes[@]}"; notify-send "System notes" "$(printf '%s\n' "${notes[@]}")" 2>/dev/null || true; }

if [ ${#problems[@]} -gt 0 ]; then
    printf '%s\n' "${problems[@]}"
    notify-send -u critical "System health" "$(printf '%s\n' "${problems[@]}")" 2>/dev/null || true
    exit 1
fi
