#!/usr/bin/env python3
"""Hourly Geizhals price watch. Sends ONE notification when an offer drops to
or below the threshold (again only when a cheaper/different deal appears).
No notification = no deal. `price-watch --dry-run` prints what it sees."""

import html
import json
import re
import subprocess
import sys
import urllib.request
from pathlib import Path

PRODUCT = "LG UltraGear 32GS94UX-B"
URL = "https://geizhals.de/lg-ultragear-oled-32gs94ux-b-a3355088.html?hloc=at&hloc=de"
THRESHOLD = 550.00  # EUR, price excl. shipping as Geizhals lists it
STATE = Path.home() / ".local/state/price-watch.json"
FAILS_BEFORE_ALERT = 3  # consecutive unreadable fetches before we say so

UA = "Mozilla/5.0 (X11; Linux x86_64; rv:140.0) Gecko/20100101 Firefox/140.0"


def fetch() -> str:
    req = urllib.request.Request(URL, headers={"User-Agent": UA, "Accept-Language": "de-DE,de;q=0.9"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.read().decode("utf-8", "replace")


def text(fragment: str) -> str:
    return re.sub(r"\s+", " ", html.unescape(re.sub(r"<[^>]+>", " ", fragment))).strip()


def offers(page: str) -> list[dict]:
    found = []
    for row in re.split(r'(?=class="offer__price offer-cell")', page)[1:]:
        price = re.search(r"€\s*([\d.]+,\d{2})", row)
        merchant = re.search(r'class="offer__merchant offer-cell"(.*?)(?:Infos|<div class="offer__merchant-)', row, re.S)
        if not price or not merchant:
            continue  # the header row
        rating = re.search(r"Bewertung: ([\d.]+) von 5", row)
        found.append({
            "price": float(price.group(1).replace(".", "").replace(",", ".")),
            "merchant": text(merchant.group(1)).lstrip("> ").strip(),
            "rating": rating.group(1) if rating else "keine",
        })
    return sorted(found, key=lambda o: o["price"])


def notify(title: str, body: str, action: bool) -> None:
    cmd = ["notify-send", "-a", "Preis-Wächter", "-u", "critical", "-i", "emblem-money", title, body]
    if not action:
        subprocess.run(cmd)
        return
    try:  # blocks until clicked or dismissed; the timer skips runs meanwhile
        choice = subprocess.run(cmd + ["-A", "open=Angebot öffnen"], capture_output=True,
                                text=True, timeout=4 * 3600).stdout.strip()
    except subprocess.TimeoutExpired:
        return
    if choice == "open":
        # own scope: a browser started here must outlive this oneshot unit
        subprocess.run(["systemd-run", "--user", "--scope", "--quiet", "xdg-open", URL])


def main() -> None:
    dry = "--dry-run" in sys.argv
    STATE.parent.mkdir(parents=True, exist_ok=True)
    state = json.loads(STATE.read_text()) if STATE.exists() else {}

    try:
        found = offers(fetch())
    except Exception as e:  # network down, Geizhals blocking, ...
        found, err = [], str(e)
    else:
        err = "keine Angebote erkannt (Seitenaufbau geändert?)"

    if not found:
        state["fails"] = state.get("fails", 0) + 1
        print(f"unreadable ({state['fails']}x): {err}")
        if state["fails"] == FAILS_BEFORE_ALERT and not dry:
            notify("Preis-Wächter kann Geizhals nicht lesen", f"{PRODUCT}: {err}", action=False)
    else:
        state["fails"] = 0
        best = found[0]
        print(f"cheapest: {best['price']:.2f} € at {best['merchant']} (rating {best['rating']}), "
              f"{len(found)} offers, threshold {THRESHOLD:.2f} €")
        key = f"{best['merchant']}|{best['price']:.2f}"
        if best["price"] <= THRESHOLD and key != state.get("notified") and not dry:
            state["notified"] = key
            STATE.write_text(json.dumps(state))  # before blocking in notify
            euro = f"{best['price']:.2f}".replace(".", ",")
            notify(f"Deal: {PRODUCT} für {euro} €",
                   f"{best['merchant']} (Händlerbewertung {best['rating']}/5), zzgl. Versand",
                   action=True)
        elif best["price"] > THRESHOLD:
            state.pop("notified", None)  # next dip counts as a new deal

    if not dry:
        STATE.write_text(json.dumps(state))


if __name__ == "__main__":
    main()
